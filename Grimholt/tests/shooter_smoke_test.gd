extends SceneTree

func _initialize() -> void:
	call_deferred("_run_smoke_test")

func _run_smoke_test() -> void:
	var packed := load("res://scenes/main.tscn") as PackedScene
	assert(packed != null, "Main scene could not be loaded")
	var game := packed.instantiate()
	root.add_child(game)
	await process_frame
	assert(game.has_method("start_solo_game"), "Main scene is missing solo start")
	assert(game.has_method("request_fire"), "Weapon logic is missing from composition root")
	assert(game.has_method("_finish_round"), "Match logic is missing from composition root")
	assert(game.get_script().resource_path == "res://scripts/shooter/main.gd", "Main scene must use the composition-root script")
	assert(load("res://assets/branding/grimholt_crest.svg") != null, "Original Grimholt crest asset is missing")
	assert(load("res://assets/branding/rifle_insignia.svg") != null, "Original rifle insignia asset is missing")
	assert(load("res://assets/materials/arena_floor.svg") != null, "Original arena floor material is missing")
	assert(InputMap.has_action("crouch"), "Crouch action was not registered")
	assert(InputMap.has_action("jump"), "Jump action was not registered")
	game.start_solo_game()
	await process_frame
	assert(game.players.has(1), "Solo player did not spawn")
	assert(game.pause_layer != null, "In-match pause layer was not created")
	assert(not game.pause_layer.visible, "Pause menu must start hidden")
	game._toggle_pause_menu()
	assert(game.is_local_paused and game.pause_layer.visible, "Pause menu did not pause local input")
	assert(game.pause_home.visible, "Pause menu home page should be visible")
	game._show_pause_section("options")
	assert(game.pause_options.visible and not game.pause_home.visible, "Pause options page did not open")
	game._resume_match()
	assert(not game.is_local_paused and not game.pause_layer.visible, "Resume did not close pause menu")
	assert(game._collect_player_states().size() == 1, "Server snapshot should include the local player")
	assert(game.bots.size() == 5, "Expected five bots in solo mode")
	var bot_logic: Node = game.bots[1000]
	assert(bot_logic.has_method("_combat_movement_direction"), "Bots need engagement-distance movement")
	assert(bot_logic.has_method("_steer_around_obstacles"), "Bots need basic obstacle steering")
	assert(bot_logic.has_method("_has_line_of_sight"), "Bots must validate line of sight before firing")
	var far_move: Vector3 = bot_logic._combat_movement_direction(Vector3(0, 0, -30), 1.0)
	assert(far_move.z < -0.5, "Bots should close distance when targets are too far away")
	var close_move: Vector3 = bot_logic._combat_movement_direction(Vector3(0, 0, -5), 1.0)
	assert(close_move.z > 0.5, "Bots should create space when targets get too close")
	var mid_move: Vector3 = bot_logic._combat_movement_direction(Vector3(0, 0, -15), 1.0)
	assert(absf(mid_move.z) < 0.35 and absf(mid_move.x) > 0.8, "Bots should strafe at preferred engagement distance")
	assert(game.SCORE_LIMIT == 50, "Round kill limit should be 50")
	assert(game.ROUND_SECONDS == 900, "Round duration should be 15 minutes")
	assert(game._format_round_time(900000) == "15:00", "900 seconds must display as 15:00")
	assert(game._format_round_time(61000) == "01:01", "Countdown must use real seconds")
	assert(game._format_round_time(60000) == "01:00", "Minute boundary must display correctly")
	assert(game._format_round_time(999) == "00:01", "Timer must not show 00:00 before expiry")
	assert(game._format_round_time(0) == "00:00", "Expired timer must display 00:00")
	assert(game._is_player_input_valid(Vector2(0.5, 0.5), 0.0, 0.0), "Valid movement input must pass")
	assert(not game._is_player_input_valid(Vector2(2.0, 0.0), 0.0, 0.0), "Oversized movement input must be rejected")
	assert(not game._is_player_input_valid(Vector2.ZERO, 0.0, deg_to_rad(90.0)), "Out-of-range pitch must be rejected")
	assert(not game._is_player_input_valid(Vector2(INF, 0.0), 0.0, 0.0), "Non-finite movement input must be rejected")
	assert(game.round_end_time_msec > Time.get_ticks_msec(), "Round must use a future monotonic deadline")
	assert(game.scoreboard_panel != null, "Scoreboard UI was not created")
	assert(game.hitmarker_label != null, "Hit confirmation UI was not created")
	assert(game.minimap.position == Vector2(24, 72), "Minimap must stay below the match clock, clear of bottom-left vitals")
	assert(game.pause_panel.theme != null, "Pause menu must use the original Grimholt UI theme")
	assert(game.pause_options.get_child(1) is CheckButton, "Pause menu must expose a working fullscreen control")
	assert(game.pause_options.get_child(3) is HSlider, "Pause menu must expose a working master-volume control")
	assert(game.has_method("_load_settings") and game.has_method("_save_settings"), "Local settings persistence is missing")
	var player: Node = game.players[1]
	game.players[77] = player
	assert(game._accept_input_packet(77, 1000), "First transform packet should pass")
	assert(not game._accept_input_packet(77, 1020), "Packets inside the rate limit must be rejected")
	assert(game._accept_input_packet(77, 1040), "A packet after the rate limit should pass")
	game.players.erase(77)
	assert(player.get_node_or_null("Head/Camera3D") != null, "Player camera is missing")
	assert(player.get_node("BodyVisual").get_child_count() >= 10, "Original player armor details were not built")
	assert(game.bots[1000].get_node("BodyVisual").get_child_count() >= 10, "Original bot armor details were not built")
	assert(player.get_node("Head/Camera3D").current, "Local player camera is not current")
	var score_before_kill := int(game.scores.get(1, 0))
	game._apply_damage(1000, 1, 100)
	assert(int(game.scores.get(1, 0)) == score_before_kill + 1, "Every kill must award exactly one point")
	game._apply_damage(1000, 1, 100)
	assert(int(game.scores.get(1, 0)) == score_before_kill + 1, "A dead target must not award duplicate kill points")
	assert(not game.scores.has(1000), "Bots must not appear as independent FFA score leaders")
	assert(not game.bots.has(1000), "Dead bot should be removed immediately")
	await create_timer(3.2).timeout
	assert(game.bots.has(1000), "Bot should respawn after its delay")
	assert(game.bots[1000].health == 100, "Respawned bot should have full health")
	# A short real-time deadline proves the clock expires by elapsed wall time,
	# rather than by a minutes/seconds formatting or frame-count shortcut.
	game.round_end_time_msec = Time.get_ticks_msec() + 1100
	await create_timer(1.25).timeout
	assert(not game.round_active, "Round must finish when the real-time deadline reaches zero")
	assert(game.timer_label.text.ends_with("00:00"), "Expired round must show 00:00")
	game._round_finished.rpc(-1, 0, "score")
	assert(game.timer_label.text.ends_with("SCORE LIMIT"), "A score-limit finish must not falsely display 00:00")
	print("SHOOTER_SMOKE_TEST_OK: scene, input, player, bots, HUD, real-time countdown, one-point kill scoring, bot death/respawn")
	quit(0)
